			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707917_B'>B.封建主义与资本主义之间的矛盾</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707917_C'>C.地主阶级与农民阶级的矛盾</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707917_D'>D.社会主义与资本主义之间的矛盾</label>
		   		
		   					
			
			</p>
	








<div class="childAnalyAdditionInfo">



	
	
	
	
		
			<div class="rA" id="DA11707917" >
				【<font color='red'>正确答案</font>】
				
					
					
					C
				
			</div>
		
		
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	

	
	
	
	
	
		
			<div class="ana" id="JX11707917" >
				【<font color='#006600'>答案解析</font>】
				旧的封建统治阶级即地主阶级，旧的被统治阶级即农民阶级，所以1840年鸦片战争前，封建社会的主要矛盾是地主阶级与农民阶级的矛盾。参见教材P22。
			</div>
		
		
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	

<script>
	function returnGsString(domain){
		var iWidth ="800";
