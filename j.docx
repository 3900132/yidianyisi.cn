<script type="text/javascript">
//判断是view 还是 op权限
function reAuth(type) {
	if(type=="view"){
		return "view";
	}else{
		return "operate";
	}
}

//提示"无权限"
function hasAuth(data,divID){
	if(data.indexOf("对不起，您没有权限进行此操作！")>-1){
		var result=eval("("+data+")");
		toNullDIV(divID);
		alert(result.msg);
		return true;
	}
	return false;
}
</script>

