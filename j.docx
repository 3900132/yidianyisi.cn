					<div align="left" style="font-size:18px;">
						
<script type="text/javascript" src="/QUIZ/theme/js/formula/mathjax/MathJax.js?config=AM_HTMLorMML-full,local/local&delayStartupUntil=configured"></script>

<input type="hidden" id="locationNum_11707903" value="129"/>
<span id="serialNum_11707903">



    </span>
    <span id="ques-content-11707903">
    129.


  
    
    新中国的国体是（　）。
  


</span>
					</div>
					<div align="left" style="font-size:18px;">
						








	
	
	
	
		
	
	
						
	
		
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707903_A'>A.宪法制度</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707903_B'>B.国家元首制度</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707903_C'>C.人民民主专政制度</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11707903_D'>D.人民代表大会制度</label>
		   		
		   					
			
			</p>
	








<div class="childAnalyAdditionInfo">



	
	
	
	
		
			<div class="rA" id="DA11707903" >
				【<font color='red'>正确答案</font>】
				
					
					
					C
				
			</div>
		
		
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	

	
	
	
	
	
		
			<div class="ana" id="JX11707903" >
				【<font color='#006600'>答案解析</font>】
				中华人民共和国是工人阶级领导的以工农联盟为基础的人民民主专政的社会主义国家。这是新中国的国体。人民代表大会制度是新中国的政体。参见教材P7。
