</span>
					</div>
					<div align="left" style="font-size:18px;">
						








	
	
	
	
		
	
	
						
	
		
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11706217_A'>A.钦州起义</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11706217_B'>B.惠州起义</label>
		   		
		   					
			
			</p>
	
		
		
		
		
			<p style="line-height:20px; margin:0px; padding:0px;">
			
			
		  		
		  		
					<label for='11706217_C'>C.广州起义</label>
		   		
		   					
			
			</p>
	
		
		
		
		
